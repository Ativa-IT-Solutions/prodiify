# WPGraphQL endpoint of the headless WordPress instance (WPGraphQL plugin required)
WORDPRESS_API_URL=https://blog.prodiify.example.com/graphql

# Shared secret for the on-demand revalidation webhook (POST /api/revalidate?secret=...)
WORDPRESS_REVALIDATE_SECRET=change-me

# Public URL of the site, used for sitemap.xml and robots.txt (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://prodiify.com
